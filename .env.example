NODE_ENV=development
PORT=3000
ROLE=all
# Public URL QPay can reach (use a tunnel such as ngrok/cloudflared in development)
PUBLIC_BASE_URL=https://your-domain.mn
DATABASE_URL=postgres://app:app@localhost:5432/integration
# openssl rand -hex 32
APP_SECRET=change-me-change-me-change-me-change-me
API_KEY=change-me-long-random-api-key

# --- QPay v2 ---
# Sandbox: https://merchant-sandbox.qpay.mn  TEST_MERCHANT / 123456 / TEST_INVOICE
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=TEST_MERCHANT
QPAY_CLIENT_SECRET=123456
QPAY_INVOICE_CODE=TEST_INVOICE

# --- Ebarimt PosAPI 3.0 ---
EBARIMT_POSAPI_URL=http://localhost:7080
EBARIMT_API_URL=https://api.ebarimt.mn
EBARIMT_MERCHANT_TIN=
EBARIMT_POS_NO=
EBARIMT_BRANCH_NO=001
# 4-digit district (дүүрэг/хороо) code of the branch
EBARIMT_DISTRICT_CODE=
EBARIMT_VAT_PAYER=true
# НХАТ rate applied to items with cityTax=true (e.g. 0.02). Confirm with your accountant.
EBARIMT_CITY_TAX_RATE=0

# --- Email ---
EMAIL_FROM="Your Shop <no-reply@mail.your-domain.mn>"
EMAIL_REPLY_TO=support@your-domain.mn
# Ordered failover chain: resend | ses
EMAIL_PROVIDERS=resend,ses
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
AWS_REGION=ap-northeast-1
SES_CONFIGURATION_SET=
